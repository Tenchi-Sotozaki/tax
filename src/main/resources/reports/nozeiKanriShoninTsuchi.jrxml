<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports 
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="nozeiKanriShoninTsuchi" pageWidth="595" pageHeight="842" 
              columnWidth="555" leftMargin="20" rightMargin="20" 
              topMargin="20" bottomMargin="20">
    
    <field name="hakkoYmd" class="java.lang.String"/>
    <field name="cityName" class="java.lang.String"/>
    <field name="jorei" class="java.lang.String"/>
    <field name="tokuJusho" class="java.lang.String"/>
    <field name="tokuName" class="java.lang.String"/>
    <field name="shisetsuJusho" class="java.lang.String"/>
    <field name="shisetsuName" class="java.lang.String"/>
    <field name="nozeiKanriJusho" class="java.lang.String"/>
    <field name="nozeiKanriName" class="java.lang.String"/>
    <field name="riyu" class="java.lang.String"/>
    
    <title>
        <band height="50" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="10" width="555" height="30"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[宿泊税納税管理人承認(不承認)通知書]]></text>
            </staticText>
        </band>
    </title>
    
    <detail>
        <band height="400" splitType="Stretch">
            <!-- 発行日 -->
            <textField>
                <reportElement x="400" y="10" width="150" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["発行日：" + $F{hakkoYmd}]]></textFieldExpression>
            </textField>
            
            <!-- 市区町村名・条例 -->
            <textField>
                <reportElement x="50" y="50" width="300" height="20"/>
                <textFieldExpression><![CDATA[$F{cityName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="50" y="70" width="300" height="20"/>
                <textFieldExpression><![CDATA[$F{jorei}]]></textFieldExpression>
            </textField>
            
            <!-- 特別徴収義務者 -->
            <staticText>
                <reportElement x="50" y="110" width="100" height="20"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[特別徴収義務者]]></text>
            </staticText>
            <textField>
                <reportElement x="70" y="130" width="400" height="20"/>
                <textFieldExpression><![CDATA["住所：" + $F{tokuJusho}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="70" y="150" width="400" height="20"/>
                <textFieldExpression><![CDATA["氏名：" + $F{tokuName}]]></textFieldExpression>
            </textField>
            
            <!-- 施設情報 -->
            <staticText>
                <reportElement x="50" y="190" width="100" height="20"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[施設情報]]></text>
            </staticText>
            <textField>
                <reportElement x="70" y="210" width="400" height="20"/>
                <textFieldExpression><![CDATA["所在地：" + $F{shisetsuJusho}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="70" y="230" width="400" height="20"/>
                <textFieldExpression><![CDATA["名称：" + $F{shisetsuName}]]></textFieldExpression>
            </textField>
            
            <!-- 納税管理人 -->
            <staticText>
                <reportElement x="50" y="270" width="100" height="20"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[納税管理人]]></text>
            </staticText>
            <textField>
                <reportElement x="70" y="290" width="400" height="20"/>
                <textFieldExpression><![CDATA["住所：" + $F{nozeiKanriJusho}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="70" y="310" width="400" height="20"/>
                <textFieldExpression><![CDATA["氏名：" + $F{nozeiKanriName}]]></textFieldExpression>
            </textField>
            
            <!-- 理由 -->
            <staticText>
                <reportElement x="50" y="350" width="100" height="20"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[理由]]></text>
            </staticText>
            <textField>
                <reportElement x="70" y="370" width="400" height="20"/>
                <textFieldExpression><![CDATA[$F{riyu}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>