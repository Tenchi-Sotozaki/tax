	<parameter name="hakkoYmd" class="java.lang.String"/>
	<parameter name="jorei" class="java.lang.String"/>
	<parameter name="city" class="java.lang.String"/>
	<parameter name="biko" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT at.jusho,
	at.name,
	tg.gassan_shitei_no,
	tg.tekiyo_st_ymd
FROM t_tokugimu tkg
	left outer join m_atena 'at' ON 
	 tkg.jichitai_cd = at.jichitai_cd 
	 AND tkg.atena_no = at.atena_no 
	left outer join t_gassan_uchi tgu ON 
	 tkg.jichitai_cd = tgu.jichitai_cd 
	 AND tkg.shitei_no = tgu.shitei_no 
	left outer join t_gassan tg ON 
	 tgu.jichitai_cd = tg.jichitai_cd 
	 AND tgu.gassan_shitei_no = tg.gassan_shitei_no]]></query>
