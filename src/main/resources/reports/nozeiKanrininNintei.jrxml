	<query language="SQL"><![CDATA[SELECT atn.jusho,
	atn.name,
	tkg.shisetsu_jusho,
	tkg.shisetsu_name
FROM t_tokugimu tkg
	left outer join m_atena atn ON 
	 tkg.jichitai_cd = atn.jichitai_cd]]></query>
