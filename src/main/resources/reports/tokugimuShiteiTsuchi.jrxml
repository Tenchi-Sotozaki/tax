			<element kind="textField" uuid="ed591281-2b96-4c1c-95e6-6f5b3d8ab719" x="150" y="400" width="370" height="80" fontName="IPAex明朝" fontSize="14.0" hTextAlign="Left" vTextAlign="Middle">
